# --- Google Analytics 4 -------------------------------------------------------
# GA4 > Admin > Data streams > Web > Measurement ID. Leave blank to disable tracking.
VITE_GA_MEASUREMENT_ID=

# --- Zoho CRM Web-to-Lead (every form submission becomes a Lead) ---------------
# Create the form in Zoho CRM: Setup > Developer Space > Web Forms (or Marketing > Web Forms), module Leads.
# Include fields: First Name, Last Name, Email, Phone, Street, City, State, Zip Code, Country, Description.
# Turn CAPTCHA off for this form (the site uses a hidden honeypot field instead), then use "Generate form code"
# and copy the values of the hidden inputs below. Use the form action host for your data centre
# (crm.zoho.com, crm.zoho.in, crm.zoho.eu, crm.zoho.com.au, crm.zoho.ca).
VITE_ZOHO_WEBFORM_URL=https://crm.zoho.com/crm/WebToLeadForm
VITE_ZOHO_XNQSJSDP=
VITE_ZOHO_XMIWTLD=
# Optional: must exactly match an existing Lead Source option in Zoho (otherwise leave blank).
VITE_ZOHO_LEAD_SOURCE=

# --- Optional email copy to the office (Web3Forms or Formspree) ----------------
# VITE_FORM_ENDPOINT=https://api.web3forms.com/submit
# VITE_FORM_ACCESS_KEY=
